# cp .env.example .env 후 채우세요. .env는 절대 커밋하지 마세요.

# 랩 구성원에게 공유할 액세스 토큰. 쉼표로 여러 개 가능.
#   openssl rand -hex 24
WM_TOKENS=changeme-run-openssl-rand-hex-24

# GitHub Pages 주소. 여기 origin만 CORS 허용됩니다.
WM_ALLOWED_ORIGINS=https://<username>.github.io

# 세션 정책
WM_SESSION_TTL=120        # 세션당 최대 초
WM_IDLE_TIMEOUT=30        # 입력 없으면 회수 (초)
WM_MAX_QUEUE=12           # 모델당 대기열 상한

# 동시 세션 수 (GPU 1장에 1이 안전)
WM_CAP_OASIS=1
WM_CAP_DIAMOND_CSGO=1
WM_CAP_DIAMOND_ATARI=2
WM_CAP_LONGLIVE=1

# 모델 로딩 시점. 기본(0)은 "실행" 버튼으로 첫 세션이 붙을 때 로드한다
# (기동만 해두면 GPU를 안 잡는다). 1이면 예전처럼 기동하자마자 미리 로드한다.
# WM_EAGER_WARMUP=0

# 그 모델을 쓰는 세션이 하나도 안 남는 순간(active==0) 바로 GPU에서 내린다.
# 기본 1(즉시 언로드). 0으로 주면 언로드하지 않는다 — 재접속이 잦아서 재로딩
# (체크포인트 로딩 시간)을 피하고 싶을 때만 0으로.
# WM_MODEL_IMMEDIATE_UNLOAD=1

# 가중치 없이 파이프라인만 확인할 때 1
WM_DUMMY=1

# 체크포인트가 있는 호스트 디렉터리
WM_WEIGHTS_DIR=./weights

# run_local.sh(도커 미사용)에서 워커별 파이썬 경로. 각 워커는 별도 프로세스로
# 뜨므로, 모델 저장소를 여러 개 등록해도 서로 섞이지 않는다.
# WM_OASIS_REPO=/path/to/open-oasis

# diamond-atari/diamond-csgo는 diamond 저장소의 서로 다른 git 브랜치(main/csgo)를 쓰는
# 별개 모델이라 저장소 경로도 따로 둔다 — 저장소 루트를 가리키면 된다
# (PYTHONPATH에 필요한 <저장소>/src 는 run_local.sh가 알아서 붙인다).
# WM_DIAMOND_ATARI_REPO=/path/to/diamond           # main 브랜치 체크아웃
# WM_DIAMOND_CSGO_REPO=/path/to/diamond-csgo       # csgo 브랜치 체크아웃 (별도 디렉터리)
# WM_DIAMOND_CSGO_SPAWN_DIR=/path/to/diamond-csgo/downloads/csgo/spawn
# WM_DIAMOND_NUM_ACTIONS=18     # 체크포인트가 학습된 게임의 ALE 액션 개수와 맞출 것

# LongLive는 반드시 v1.0 브랜치여야 한다 (main=LongLive 2.0/5B 오프라인 배치 파이프라인이라
# 이 프로젝트가 쓰는 실시간 스트리밍 어댑터와 안 맞는다). 코드 자체가 wan_models/... 를
# 상대경로로 찾으므로, WM_LONGLIVE_REPO는 그 디렉터리 구조를 갖춘 저장소 루트여야 한다.
# WM_LONGLIVE_REPO=/path/to/LongLive   # git checkout v1.0 상태
# WM_LONGLIVE_PROMPTS=문장1|문장2|문장3   # hotbar 1~9로 전환할 프롬프트 목록 ('|' 구분)

# Oasis 시작 프레임 (저장소의 sample_data/sample_image_0.png로 시작해도 된다)
# WM_OASIS_PROMPT=/path/to/open-oasis/sample_data/sample_image_0.png
# DIAMOND(Atari) 시작 프레임 (없으면 회색 화면으로 시작)
# WM_DIAMOND_ATARI_PROMPT=/path/to/start_frame.png

# 품질/속도 트레이드오프
WM_DIFFUSION_STEPS=8      # Oasis
WM_DENOISE_STEPS=3        # DIAMOND
WM_FPS_OASIS=20
WM_FPS_LONGLIVE=16

# Cloudflare 대시보드에서 터널 생성 후 발급되는 토큰
CF_TUNNEL_TOKEN=
