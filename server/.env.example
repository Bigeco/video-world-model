# cp .env.example .env 후 채우세요. .env는 절대 커밋하지 마세요.

# 랩 구성원에게 공유할 액세스 토큰. 쉼표로 여러 개 가능.
#   openssl rand -hex 24
WM_TOKENS=changeme-run-openssl-rand-hex-24

# GitHub Pages 주소. 여기 origin만 CORS 허용됩니다.
WM_ALLOWED_ORIGINS=https://<username>.github.io

# 세션 정책
WM_SESSION_TTL=120        # 세션당 최대 초
WM_IDLE_TIMEOUT=30        # 입력 없으면 회수 (초)
WM_MAX_QUEUE=12           # 모델당 대기열 상한

# 동시 세션 수 (GPU 1장에 1이 안전)
WM_CAP_OASIS=1
WM_CAP_DIAMOND_CSGO=1
WM_CAP_DIAMOND_ATARI=2

# 가중치 없이 파이프라인만 확인할 때 1
WM_DUMMY=1

# 체크포인트가 있는 호스트 디렉터리
WM_WEIGHTS_DIR=./weights

# run_local.sh(도커 미사용)에서 워커별 파이썬 경로. 각 워커는 별도 프로세스로
# 뜨므로, 모델 저장소를 여러 개 등록해도 서로 섞이지 않는다.
# WM_OASIS_REPO=/path/to/open-oasis
# WM_DIAMOND_REPO=/path/to/diamond

# 품질/속도 트레이드오프
WM_DIFFUSION_STEPS=8      # Oasis
WM_DENOISE_STEPS=3        # DIAMOND
WM_FPS_OASIS=20

# Cloudflare 대시보드에서 터널 생성 후 발급되는 토큰
CF_TUNNEL_TOKEN=
