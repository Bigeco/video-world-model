# ===========================================================
# 절대 커밋되면 안 되는 것들 — 첫 커밋 전에 이 파일부터 두세요.
# ===========================================================

# 토큰·터널 자격증명이 들어 있는 실제 설정
.env
.env.*
!.env.example
*.env

# Cloudflare 터널 자격증명
.cloudflared/
*.cloudflared.json
cert.pem

# SSH 키가 실수로 들어오는 경우 방지
id_rsa*
id_ed25519*
*.pem
*.key

# ===========================================================
# 용량이 크거나 재생성 가능한 것들
# ===========================================================

# 모델 체크포인트
weights/
*.pt
*.pth
*.ckpt
*.safetensors
*.bin

# 파이썬 환경
.venv/
.venv-*/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 실행 중 생기는 로그·PID (서버 경로·포트가 노출될 수 있음)
.run/
*.log
*.pid

# 캡처·녹화 결과물
frames/
recordings/
*.mp4

# ===========================================================
# 에디터 / OS
# ===========================================================
.DS_Store
.vscode/
.idea/
*.swp
*~